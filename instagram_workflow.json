    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Get only media files\nconst media = items.filter(item => {\n  const name = item.json.name || '';\n  return /\\.(jpg|jpeg|png|mp4|mov)$/i.test(name);\n});\n\nif (media.length === 0) {\n  return [];\n}\n\n// Take only ONE media file per scheduler run\nconst selected = media[0];\n\nconst mediaName = selected.json.name;\n\n// Remove extension to get base name\nconst baseName = mediaName.replace(/\\.[^.]+$/, '');\n\n// Find TXT matching the SAME base name\nconst captionFile = items.find(item => {\n  const name = item.json.name || '';\n  return name.toLowerCase() === `${baseName}.txt`.toLowerCase();\n});\n\nreturn [{\n  json: {\n    id: selected.json.id,\n    name: selected.json.name,\n    captionFileId: captionFile?.json.id || null,\n  }\n}];"
      },
