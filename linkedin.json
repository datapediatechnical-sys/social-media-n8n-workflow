      "parameters": {
        "jsCode": "const item = $input.first();\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst instructions =\n  $('Photo Initialize Upload1').first().json.body.value.uploadInstructions;\n\nconst output = [];\n\nfor (let i = 0; i < instructions.length; i++) {\n  const instruction = instructions[i];\n\n  const chunk = buffer.subarray(\n    instruction.firstByte,\n    instruction.lastByte + 1\n  );\n\n  output.push({\n    json: {\n      chunkIndex: i,\n      firstByte: instruction.firstByte,\n      lastByte: instruction.lastByte,\n      totalBytes: buffer.length,\n      uploadUrl: instruction.uploadUrl\n    },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        chunk,\n        item.binary.data.fileName,\n        item.binary.data.mimeType\n      )\n    }\n  });\n}\n\nreturn output;"
      },
