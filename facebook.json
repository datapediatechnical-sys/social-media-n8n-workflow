    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst mediaExtensions = /\\.(jpg|jpeg|png|mp4|mov)$/i;\nconst txtExtension = /\\.txt$/i;\n\n// Find media files\nconst media = items.filter(item =>\n  mediaExtensions.test(item.json.name || '')\n);\n\n// If media exists, select the first media file\nif (media.length > 0) {\n  const selected = media[0];\n  const mediaName = selected.json.name;\n  const baseName = mediaName.replace(/\\.[^.]+$/, '');\n\n  // Find matching caption\n  const captionFile = items.find(item => {\n    const name = item.json.name || '';\n    return name.toLowerCase() === `${baseName}.txt`.toLowerCase();\n  });\n\n  return [{\n    json: {\n      id: selected.json.id,\n      name: selected.json.name,\n      captionFileId: captionFile?.json.id || null,\n      postType: 'media'\n    }\n  }];\n}\n\n// No media → check for text-only post\nconst txtFile = items.find(item =>\n  txtExtension.test(item.json.name || '')\n);\n\nif (txtFile) {\n  return [{\n    json: {\n      id: txtFile.json.id,\n      name: txtFile.json.name,\n      captionFileId: null,\n      postType: 'text'\n    }\n  }];\n}\n\n// Nothing to post\nreturn [];"
      },
